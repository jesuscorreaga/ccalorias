
# MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Clave para firmar los tokens
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# API key de Gemini
GEMINI_API_KEY=tu_api_key_de_gemini

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Orígenes permitidos por CORS
# Separar múltiples orígenes mediante comas.
# Si está vacía o no existe, utiliza http://localhost:8081
CORS_ORIGINS=http://localhost:8081
