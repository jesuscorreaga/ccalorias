# Connection string de MongoDB Atlas (Connect, Drivers)
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Clave para firmar los tokens. Genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# API key de Gemini (aistudio.google.com)
GEMINI_API_KEY=tu_api_key_de_gemini

# Cloudinary (cloudinary.com, plan gratuito): consola, sección API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
# Orígenes permitidos por CORS (solo afecta a la versión web de la app), separados por comas.
# Si se borra o queda vacía, se usa http://localhost:8081
CORS_ORIGINS=http://localhost:8081